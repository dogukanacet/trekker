// FleetOps — Hafta 1 şeması
// Multi-tenant hiyerarşi: Tenant (firma) -> Depot (depo/hub) -> Vehicle / Driver
// Not: Hafta 3'te Vehicle.currentLat/currentLng gibi düz alanlarla başlanacak;
// ölçek gerekirse PostGIS'e (geography tipi) geçiş bir sonraki adım.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
}

enum DispatchStatus {
 PLANNED
 IN_PROGRESS
 COMPLETED
 CANCELLED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  depots Depot[]
  users  User[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         Role     @default(DISPATCHER)
  createdAt    DateTime @default(now())
}

model Depot {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String

  vehicles Vehicle[]
  drivers  Driver[]
  routes   Route[]
}

model Vehicle {
  id              String   @id @default(cuid())
  depotId         String
  depot           Depot    @relation(fields: [depotId], references: [id])
  plate           String@unique
  model           String?
  insuranceUntil  DateTime?
  inspectionUntil DateTime?
  createdAt       DateTime @default(now())
  dispatches      Dispatch[]
}

model Driver {
  id             String    @id @default(cuid())
  depotId        String
  depot          Depot     @relation(fields: [depotId], references: [id])
  fullName       String
  licenseUntil   DateTime
  createdAt      DateTime  @default(now())
  dispatches     Dispatch[]
}

model Route {
  id             String    @id @default(cuid())
  depotId        String
  depot          Depot     @relation(fields: [depotId], references: [id])
  name           String
  createdAt      DateTime  @default(now())
  stops          RouteStop[]
  dispatches     Dispatch[]
}

model RouteStop {
  id             String    @id @default(cuid())
  routeId        String
  route          Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  label          String
  lat            Float
  lng            Float
  order          Int
}

model Dispatch {
  id            String          @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id])
  driverId      String
  driver        Driver          @relation(fields: [driverId], references: [id])
  routeId       String
  route         Route           @relation(fields: [routeId], references: [id])
  status        DispatchStatus  @default(PLANNED)
  date          DateTime        @default(now())
}