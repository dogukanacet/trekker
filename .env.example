DATABASE_URL=
AUTH_SECRET=
REFRESH_TOKEN_EXPIRE_MS=
ACCESS_TOKEN_EXPIRE_MS=
RESEND_API_KEY=


# Optional: any valid email you are fine sharing with MyMemory. Raises its daily limit
# from 5,000 to 50,000 characters. Strongly recommended on Vercel, where the shared
# outbound IPs eat the anonymous quota.
MYMEMORY_EMAIL=

# Optional: Cloudflare Workers AI (free plan). Create an API token with Workers AI access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Optional: "mymemory" | "cloudflare". Default: cloudflare when its two variables are set, otherwise mymemory.
TRANSLATION_PROVIDER=